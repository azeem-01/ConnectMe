<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Captive portals intercept HTTP (never HTTPS). Canary checks must stay cleartext. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
